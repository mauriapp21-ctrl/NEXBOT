# Copy to .env.local (never committed) to allow using the real engine from
# another address (e.g. the tunnel) after signing in at /login.
# Without these values remote access to the engine stays disabled.
ENGINE_LOGIN_USER=admin
# At least 12 characters.
ENGINE_LOGIN_PASSWORD=
# Random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
